// Describes the database that supabase/migrations already creates. It does not
// own it: the migration is still the source of truth, and this file maps onto
// it. Keep them in step, and never run `prisma migrate` against this database.
//
// The engine is the client query compiler, so there is no Rust binary to ship,
// which is what lets this run on Cloudflare Workers.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  engineType   = "client"
  runtime      = "workerd"
  moduleFormat = "esm"
}

// Prisma 7 keeps connection details out of the schema. The Worker passes a
// connection to the client through the pg driver adapter, and CLI commands
// read prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// `@default` here mirrors the defaults supabase/migrations already sets, so
// Prisma knows these columns are optional on insert.
model Profile {
  id          String  @id @db.Uuid
  displayName String  @map("display_name")
  avatarUrl   String? @map("avatar_url")

  // The only fields a person may change themselves. See `preferenceFields`.
  dailyLimit           Int     @map("daily_limit")
  counterStyle         String  @map("counter_style")
  counterPositionX     Float   @map("counter_position_x") @db.Real
  counterPositionY     Float   @map("counter_position_y") @db.Real
  notificationsEnabled Boolean @map("notifications_enabled")
  screenTimeGranted    Boolean @map("screen_time_granted")
  overlayGranted       Boolean @map("overlay_granted")

  inviteCode      String?   @unique @map("invite_code")
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz(6)

  subscriptionStatus    String    @map("subscription_status")
  subscriptionProductId String?   @map("subscription_product_id")
  subscriptionStore     String?   @map("subscription_store")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at") @db.Timestamptz(6)

  /// Generated by the database from subscriptionStatus. Never written from here.
  premium Boolean

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  usage      DailyUsage[]
  friends    Friendship[]         @relation("friendshipOwner")
  friendOf   Friendship[]         @relation("friendshipFriend")
  feedback   Feedback[]
  onboarding OnboardingProgress[]

  @@map("profiles")
}

model DailyUsage {
  userId    String   @map("user_id") @db.Uuid
  usageDate DateTime @map("usage_date") @db.Date
  appKey    String   @map("app_key")
  reels     Int

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, usageDate, appKey])
  @@map("daily_usage")
}

model Friendship {
  userId    String   @map("user_id") @db.Uuid
  friendId  String   @map("friend_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner  Profile @relation("friendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend Profile @relation("friendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@index([friendId])
  @@map("friendships")
}

model Feedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  topic     String
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model OnboardingProgress {
  installId    String    @id @map("install_id") @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  currentStep  String    @map("current_step")
  furthestStep String    @map("furthest_step")
  /// When this install first reached each step, { "concept": "2026-..." }.
  reachedAt    Json      @map("reached_at")
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  profile Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("onboarding_progress")
}
