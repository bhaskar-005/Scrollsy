<?xml version="1.0" encoding="utf-8"?>
<!--
  Reads what is on screen, because a scroll on its own cannot tell a real reel
  from a nudge that snapped back. Both arrive as the same event. The service
  waits for the screen to settle and asks what is showing, and only a screen
  that changed is a reel that changed.

  Every app is in scope rather than five, because leaving Instagram is a window
  change belonging to whatever you left it for, and the pill has to know to get
  out of the way. Only the five packages in `ReelStore.Apps` are ever counted,
  and nothing read is kept. See `fingerprint` in ReelCounterService.
-->
<accessibility-service
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeViewScrolled|typeWindowStateChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:notificationTimeout="100"
  android:canRetrieveWindowContent="true"
  android:description="@string/reel_counter_service_description" />
