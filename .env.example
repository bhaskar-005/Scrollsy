# Copy to .env.local, which git ignores.
#
# The app knows two addresses and one public client id. It never holds a
# Supabase URL, a Supabase key, or any secret: those are Worker secrets, see
# api/.dev.vars.example.

# The Doomless API, a Cloudflare Worker in /api.
#
# Once deployed this is https://doomless-api.<your-subdomain>.workers.dev/v1,
# or your own domain in front of it. With `npm --prefix api run dev` it is
# http://<your computer's LAN IP>:8787/v1, since a phone cannot reach
# 127.0.0.1 on your computer.
#
# Leave it unset and the app still runs and still counts locally. It just never
# syncs, and nobody can sign in.
EXPO_PUBLIC_API_URL=https://doomless-api.your-subdomain.workers.dev/v1

# Where invite links point. The Astro site in /web serves them and sends people
# either into the app or to the Play listing.
EXPO_PUBLIC_SITE_URL=https://scrollsy.app

# Google sign in. From Google Cloud, APIs and Services, Credentials.
#
# Use the *Web* client id even on Android. Android also needs its own OAuth
# client, made with the package name com.scrollsy.app and the SHA-1 of the
# signing key, but its id is never entered anywhere: Google matches it by
# signature. The same Web client id goes into Supabase, under Authentication,
# Providers, Google, as an authorized client id.
#
# Needs a development build. Google sign in cannot work in Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Payments. The public SDK key for Android, from the RevenueCat dashboard,
# Project Settings, API keys. Public on purpose: it can only read offerings and
# make purchases as whoever is holding the phone.
#
# The secret keys, and the webhook, are Worker side, see api/.dev.vars.example.
#
# Needs a development build, like Google sign in. Unset, the paywall shows the
# written prices and says plans are not on sale yet.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your_public_sdk_key
