# .easignore replaces .gitignore for EAS Build uploads, so it must
# repeat everything .gitignore excludes plus the extra folders below.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# EAS clones the repo into the build archive and only drops the cloned .git
# when this exact pattern is listed. A trailing slash does not match.
.git

# not part of the Expo app, not needed in the EAS build
api/
api-prisma/
brainpal-ref/
design-ref/
web/
docs/
supabase/
test/
scripts/
deno.lock
README.md
LICENSE
.claude/
.vscode/
