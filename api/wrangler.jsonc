{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doomless-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // Serve the Worker on its workers.dev URL. The app and the RevenueCat webhook
  // reach it there until a custom domain is set.
  "workers_dev": true,

  // Every request makes at least one call to Supabase, which lives in one
  // region. Smart Placement runs the Worker near that database instead of near
  // the caller, so the chatty leg of each request is the short one.
  "placement": { "mode": "smart" },

  "observability": { "enabled": true },

  "vars": {
    "REVENUECAT_ENTITLEMENT_ID": "pro"
  },

  // Set each one with `npx wrangler secret put NAME`. For `npm run dev`, put
  // them in `.dev.vars`, see `.dev.vars.example`.
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_SECRET_KEY",
      "JWT_SECRET",
      "GOOGLE_CLIENT_ID",
      "REVENUECAT_WEBHOOK_AUTH",
      "REVENUECAT_API_KEY"
    ]
  },

  // Counted per Cloudflare location and deliberately approximate, which is the
  // right trade for stopping abuse without a round trip to any store.
  "ratelimits": [
    {
      // A signed in person. Sync runs once a minute, so this leaves wide room.
      "name": "USER_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // Signed out routes, onboarding progress and invite previews, keyed per
      // install or per invite code since there is no account to key on yet.
      "name": "PUBLIC_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
